<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ════════════════════════════════════════════════════════════════
             KANBAN — Editorial hold feed
             ════════════════════════════════════════════════════════════════ -->

        <record id="view_darakjian_hold_kanban" model="ir.ui.view">
            <field name="name">darakjian.hold.kanban</field>
            <field name="model">darakjian.hold</field>
            <field name="arch" type="xml">
                <kanban class="o_darakjian_post" default_order="date_expires asc" sample="1">
                    <field name="id"/>
                    <field name="name"/>
                    <field name="product_id"/>
                    <field name="partner_id"/>
                    <field name="salesperson_id"/>
                    <field name="date_start"/>
                    <field name="date_expires"/>
                    <field name="state"/>
                    <field name="sale_order_id"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="o_kanban_record o_darakjian_post_card">
                                <div class="o_dk_post_hero">
                                    <img t-att-src="kanban_image('product.product', 'image_512', record.product_id.raw_value)"
                                         alt="Piece" class="o_dk_post_hero_image"/>
                                </div>
                                <div class="o_dk_post_title">
                                    <field name="product_id"/>
                                </div>
                                <div class="o_dk_post_subtitle">
                                    <i class="fa fa-user-circle-o me-1"/>
                                    <field name="partner_id"/>
                                </div>
                                <div class="o_dk_post_body">
                                    <div class="o_dk_hold_dates">
                                        <span class="text-muted">Expires:</span>
                                        <strong>
                                            <field name="date_expires" widget="remaining_days"/>
                                        </strong>
                                    </div>
                                    <div class="o_dk_post_meta">
                                        <i class="fa fa-user-circle me-1"/>
                                        <field name="salesperson_id"/>
                                    </div>
                                </div>
                                <div class="o_dk_post_footer">
                                    <span t-attf-class="o_dk_pill o_dk_pill_#{record.state.raw_value}">
                                        <field name="state"/>
                                    </span>
                                    <span class="o_dk_post_meta" t-if="record.sale_order_id.raw_value">
                                        <i class="fa fa-check-circle me-1"/>
                                        <field name="sale_order_id"/>
                                    </span>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- ════════════════════════════════════════════════════════════════
             FORM
             ════════════════════════════════════════════════════════════════ -->

        <record id="view_darakjian_hold_form" model="ir.ui.view">
            <field name="name">darakjian.hold.form</field>
            <field name="model">darakjian.hold</field>
            <field name="arch" type="xml">
                <form class="o_darakjian_post">
                    <header>
                        <button name="action_extend" type="object"
                                string="Extend +7 days"
                                class="oe_highlight"
                                invisible="state != 'active'"/>
                        <button name="action_cancel" type="object"
                                string="Cancel"
                                invisible="state in ('cancelled', 'converted')"
                                confirm="Cancel this hold? The piece becomes available again for other clients."/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="active,converted"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group string="Reservation">
                                <field name="product_id"
                                       options="{'no_create_edit': True}"
                                       readonly="state != 'active'"/>
                                <field name="partner_id"
                                       options="{'no_create_edit': True}"
                                       readonly="state != 'active'"/>
                                <field name="salesperson_id"
                                       readonly="state != 'active'"/>
                            </group>
                            <group string="Window">
                                <field name="date_start"
                                       readonly="state != 'active'"/>
                                <field name="date_expires"
                                       readonly="state != 'active'"/>
                                <field name="sale_order_id" readonly="1"
                                       invisible="state != 'converted'"/>
                            </group>
                        </group>
                        <group string="Notes">
                            <field name="notes" nolabel="1"
                                   placeholder="What did the client say? Anything we should remember when they come back..."/>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- ════════════════════════════════════════════════════════════════
             LIST
             ════════════════════════════════════════════════════════════════ -->

        <record id="view_darakjian_hold_list" model="ir.ui.view">
            <field name="name">darakjian.hold.list</field>
            <field name="model">darakjian.hold</field>
            <field name="arch" type="xml">
                <list default_order="date_expires asc">
                    <field name="name"/>
                    <field name="product_id"/>
                    <field name="partner_id"/>
                    <field name="salesperson_id"/>
                    <field name="date_start" optional="hide"/>
                    <field name="date_expires" widget="remaining_days"/>
                    <field name="state" decoration-success="state == 'converted'"
                                         decoration-info="state == 'active'"
                                         decoration-warning="state == 'expired'"
                                         decoration-muted="state == 'cancelled'"/>
                    <field name="sale_order_id" optional="show"/>
                </list>
            </field>
        </record>

        <!-- ════════════════════════════════════════════════════════════════
             SEARCH
             ════════════════════════════════════════════════════════════════ -->

        <record id="view_darakjian_hold_search" model="ir.ui.view">
            <field name="name">darakjian.hold.search</field>
            <field name="model">darakjian.hold</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="product_id"/>
                    <field name="partner_id"/>
                    <field name="salesperson_id"/>
                    <field name="sale_order_id"/>
                    <filter name="filter_mine" string="Mine"
                            domain="[('salesperson_id', '=', uid)]"/>
                    <filter name="filter_active" string="Active"
                            domain="[('state', '=', 'active')]"/>
                    <filter name="filter_expiring_soon" string="Expiring &lt;48h"
                            domain="[('state', '=', 'active'),
                                     ('date_expires', '&lt;=', (datetime.datetime.now() + relativedelta(days=2)).strftime('%Y-%m-%d %H:%M:%S'))]"/>
                    <filter name="filter_expired" string="Expired"
                            domain="[('state', '=', 'expired')]"/>
                    <filter name="filter_converted" string="Converted"
                            domain="[('state', '=', 'converted')]"/>
                    <filter name="filter_cancelled" string="Cancelled"
                            domain="[('state', '=', 'cancelled')]"/>
                    <separator/>
                    <filter name="filter_with_sale_order" string="With sale order"
                            domain="[('sale_order_id', '!=', False)]"/>
                    <group expand="0" string="Group by">
                        <filter name="groupby_state" string="State"
                                context="{'group_by': 'state'}"/>
                        <filter name="groupby_salesperson" string="Advisor"
                                context="{'group_by': 'salesperson_id'}"/>
                        <filter name="groupby_partner" string="Client"
                                context="{'group_by': 'partner_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- ════════════════════════════════════════════════════════════════
             WINDOW ACTION + MENU ITEM
             ════════════════════════════════════════════════════════════════ -->

        <record id="action_darakjian_hold" model="ir.actions.act_window">
            <field name="name">Holds</field>
            <field name="res_model">darakjian.hold</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="search_view_id" ref="view_darakjian_hold_search"/>
            <field name="context">{'search_default_filter_mine': 1, 'search_default_filter_active': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">No holds yet.</p>
                <p>Reserve a piece for a client with a clear expiration window. The system warns the advisor 48 h before expiry and frees the piece automatically when the window closes.</p>
            </field>
        </record>

        <menuitem id="menu_darakjian_hold"
                  name="Holds"
                  parent="menu_darakjian_process"
                  action="action_darakjian_hold"
                  sequence="20"
                  groups="group_darakjian_advisor"/>

    </data>
</odoo>
