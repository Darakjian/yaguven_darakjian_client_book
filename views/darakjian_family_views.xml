<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ════════════════════════════════════════════════════════════════
             KANBAN — Editorial family feed
             ════════════════════════════════════════════════════════════════ -->

        <record id="view_darakjian_family_kanban" model="ir.ui.view">
            <field name="name">darakjian.family.kanban</field>
            <field name="model">darakjian.family</field>
            <field name="arch" type="xml">
                <kanban class="o_darakjian_post" default_order="name asc" sample="1">
                    <field name="id"/>
                    <field name="name"/>
                    <field name="primary_contact_partner_id"/>
                    <field name="member_count"/>
                    <field name="active"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="o_kanban_record o_darakjian_post_card">
                                <div class="o_dk_post_title">
                                    <i class="fa fa-users me-2"/>
                                    <field name="name"/>
                                </div>
                                <div class="o_dk_post_subtitle"
                                     t-if="record.primary_contact_partner_id.raw_value">
                                    <i class="fa fa-star me-1"/>
                                    <field name="primary_contact_partner_id"/>
                                </div>
                                <div class="o_dk_post_body">
                                    <span class="o_dk_pill o_dk_pill_4cs">
                                        <field name="member_count"/> member(s)
                                    </span>
                                </div>
                                <div class="o_dk_post_footer">
                                    <span t-if="!record.active.raw_value"
                                          class="o_dk_pill o_dk_pill_cancelled">
                                        Archived
                                    </span>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- ════════════════════════════════════════════════════════════════
             FORM — Family with embedded members
             ════════════════════════════════════════════════════════════════ -->

        <record id="view_darakjian_family_form" model="ir.ui.view">
            <field name="name">darakjian.family.form</field>
            <field name="model">darakjian.family</field>
            <field name="arch" type="xml">
                <form class="o_darakjian_post">
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_open_members" type="object"
                                    class="oe_stat_button" icon="fa-users">
                                <field name="member_count" widget="statinfo"
                                       string="Members"/>
                            </button>
                        </div>
                        <widget name="web_ribbon" title="Archived"
                                bg_color="text-bg-danger"
                                invisible="active"/>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Family name (e.g. The Romero family)"/>
                            </h1>
                            <div class="o_dk_post_subtitle"
                                 invisible="not primary_contact_partner_id">
                                <i class="fa fa-star me-1"/>
                                Primary contact:
                                <field name="primary_contact_partner_id" readonly="1"/>
                            </div>
                        </div>
                        <notebook>
                            <page string="Members" name="members">
                                <field name="member_ids">
                                    <list editable="bottom"
                                          default_order="is_primary_contact desc, id asc">
                                        <field name="partner_id"
                                               options="{'no_create_edit': True}"/>
                                        <field name="role"/>
                                        <field name="is_primary_contact"
                                               widget="boolean_toggle"/>
                                        <field name="notes" optional="show"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Notes" name="notes">
                                <field name="notes" nolabel="1"
                                       placeholder="Family-level context: how they came to us, shared celebrations, taboos..."/>
                            </page>
                        </notebook>
                        <field name="active" invisible="1"/>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- ════════════════════════════════════════════════════════════════
             LIST
             ════════════════════════════════════════════════════════════════ -->

        <record id="view_darakjian_family_list" model="ir.ui.view">
            <field name="name">darakjian.family.list</field>
            <field name="model">darakjian.family</field>
            <field name="arch" type="xml">
                <list default_order="name asc">
                    <field name="name"/>
                    <field name="primary_contact_partner_id" optional="show"/>
                    <field name="member_count" string="Members"/>
                    <field name="active" optional="hide"/>
                </list>
            </field>
        </record>

        <!-- ════════════════════════════════════════════════════════════════
             SEARCH
             ════════════════════════════════════════════════════════════════ -->

        <record id="view_darakjian_family_search" model="ir.ui.view">
            <field name="name">darakjian.family.search</field>
            <field name="model">darakjian.family</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="primary_contact_partner_id"/>
                    <field name="member_ids" string="Member"
                           filter_domain="[('member_ids.partner_id', 'ilike', self)]"/>
                    <filter name="filter_active" string="Active"
                            domain="[('active', '=', True)]"/>
                    <filter name="filter_archived" string="Archived"
                            domain="[('active', '=', False)]"/>
                    <separator/>
                    <filter name="filter_with_primary" string="With primary contact"
                            domain="[('primary_contact_partner_id', '!=', False)]"/>
                    <filter name="filter_no_primary" string="Missing primary contact"
                            domain="[('primary_contact_partner_id', '=', False)]"/>
                </search>
            </field>
        </record>

        <!-- ════════════════════════════════════════════════════════════════
             FAMILY MEMBER — list/form for the act_window opened from family
             ════════════════════════════════════════════════════════════════ -->

        <record id="view_darakjian_family_member_list" model="ir.ui.view">
            <field name="name">darakjian.family.member.list</field>
            <field name="model">darakjian.family.member</field>
            <field name="arch" type="xml">
                <list default_order="family_id, is_primary_contact desc, id asc">
                    <field name="family_id"/>
                    <field name="partner_id"/>
                    <field name="role"/>
                    <field name="is_primary_contact"/>
                </list>
            </field>
        </record>

        <record id="view_darakjian_family_member_form" model="ir.ui.view">
            <field name="name">darakjian.family.member.form</field>
            <field name="model">darakjian.family.member</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="family_id"
                                       options="{'no_create_edit': True}"/>
                                <field name="partner_id"
                                       options="{'no_create_edit': True}"/>
                            </group>
                            <group>
                                <field name="role"/>
                                <field name="is_primary_contact"/>
                            </group>
                        </group>
                        <group string="Notes">
                            <field name="notes" nolabel="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ════════════════════════════════════════════════════════════════
             WINDOW ACTION + MENU ITEM
             ════════════════════════════════════════════════════════════════ -->

        <record id="action_darakjian_family" model="ir.actions.act_window">
            <field name="name">Families</field>
            <field name="res_model">darakjian.family</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="search_view_id" ref="view_darakjian_family_search"/>
            <field name="context">{'search_default_filter_active': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">No families yet.</p>
                <p>Group clients into families to recognize who's celebrating together, who shops for whom, and who decides.</p>
            </field>
        </record>

        <menuitem id="menu_darakjian_family"
                  name="Families"
                  parent="menu_darakjian_process"
                  action="action_darakjian_family"
                  sequence="50"
                  groups="group_darakjian_advisor"/>

    </data>
</odoo>
