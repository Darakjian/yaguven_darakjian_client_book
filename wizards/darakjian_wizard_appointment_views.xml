<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_darakjian_wizard_appointment_form" model="ir.ui.view">
            <field name="name">darakjian.wizard.appointment.form</field>
            <field name="model">darakjian.wizard.appointment</field>
            <field name="arch" type="xml">
                <form string="Schedule appointment">
                    <sheet>
                        <group>
                            <group string="Client and advisor">
                                <field name="partner_id"
                                       options="{'no_create_edit': True}"/>
                                <field name="salesperson_id"
                                       options="{'no_create_edit': True}"/>
                                <field name="kind"/>
                            </group>
                            <group string="Window">
                                <field name="datetime_start"/>
                                <field name="duration_hours"/>
                                <field name="confirm_immediately"/>
                            </group>
                        </group>
                        <group string="Prepared selection"
                               invisible="not partner_id">
                            <field name="wishlist_id"
                                   options="{'no_create_edit': True}"/>
                            <field name="hold_ids"
                                   widget="many2many_tags"
                                   options="{'no_create_edit': True}"/>
                        </group>
                        <group string="Internal notes"
                               invisible="not partner_id">
                            <field name="notes_internal" nolabel="1"
                                   placeholder="What the client values, conversation hooks, sizes already known..."/>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_schedule" type="object"
                                string="Schedule"
                                class="oe_highlight"/>
                        <button special="cancel" string="Cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_darakjian_wizard_appointment" model="ir.actions.act_window">
            <field name="name">Schedule appointment</field>
            <field name="res_model">darakjian.wizard.appointment</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="binding_model_id" ref="base.model_res_partner"/>
            <field name="binding_view_types">form</field>
            <field name="groups_id" eval="[(4, ref('group_darakjian_advisor'))]"/>
        </record>

    </data>
</odoo>
